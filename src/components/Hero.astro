---
import profile from "../assets/profile.avif";
---

<section
  id="home"
  class="min-h-screen flex items-center px-6"
>
  <div
    class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center"
  >

    <!-- Texto -->
    <div>

      <p class="text-cyan-400 uppercase tracking-[0.3em] mb-4">
        Ingeniería Civil Telemática
      </p>

      <h1 class="text-5xl md:text-7xl font-bold mb-6">
        Juan Gutiérrez
      </h1>

      <p class="text-zinc-400 text-lg md:text-xl mb-8">
        Estudiante de Ingeniería Civil Telemática apasionado por el
        desarrollo de software, redes, telecomunicaciones,
        Internet de las Cosas (IoT) y tecnologías web modernas.
      </p>

      <div class="flex flex-wrap gap-4 mb-8">

        <a
          href="#projects"
          class="bg-cyan-400 hover:bg-cyan-300 text-black px-6 py-3 rounded-xl font-semibold transition"
        >
          Ver proyectos
        </a>

        <a
          href="#contact"
          class="border border-zinc-700 hover:border-cyan-400 px-6 py-3 rounded-xl transition"
        >
          Contacto
        </a>

      </div>

      <div class="flex flex-wrap gap-6 text-zinc-400">

        <a
          href="https://github.com/jucahas"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-cyan-400 transition"
        >
          GitHub
        </a>

        <a
          href="https://www.linkedin.com/in/juan-gutiérrez-astudillo-131373171"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-cyan-400 transition"
        >
          LinkedIn
        </a>

        <a
          href="/cv.pdf"
          class="hover:text-cyan-400 transition"
        >
          CV
        </a>

      </div>

    </div>

    <!-- Foto -->
    <div class="flex justify-center">

      <img
        src={profile.src}
        alt="Juan Gutiérrez"
        class="w-72 h-72 md:w-96 md:h-96 object-cover rounded-full border-4 border-cyan-400 shadow-xl shadow-cyan-500/20"
      />

    </div>

  </div>
</section>