---
import { projects } from "../data/projects.js";
---

<div class="grid md:grid-cols-2 gap-8">

  {
    projects.map((project) => (

      <div
        class="bg-zinc-900 border border-zinc-800 rounded-3xl overflow-hidden hover:border-cyan-400 transition"
      >

        <div
          class={`h-52 flex items-center justify-center ${
            project.color === "cyan"
              ? "bg-gradient-to-br from-cyan-500/20 to-zinc-900"
              : "bg-gradient-to-br from-purple-500/20 to-zinc-900"
          }`}
        >

          <span
            class={`text-xl font-bold ${
              project.color === "cyan"
                ? "text-cyan-400"
                : "text-purple-400"
            }`}
          >
            {project.title}
          </span>

        </div>

        <div class="p-8">

          <h3 class="text-2xl font-bold mb-4">
            {project.subtitle}
          </h3>

          <p class="text-zinc-400 mb-6">
            {project.description}
          </p>

          <div class="flex flex-wrap gap-3 mb-6">

            {
              project.technologies.map((tech) => (

                <span
                  class="bg-zinc-800 px-3 py-1 rounded-full text-sm"
                >
                  {tech}
                </span>

              ))
            }

          </div>

          <div class="flex gap-4">

            <a
              href={project.github}
              class="bg-cyan-400 hover:bg-cyan-300 text-black px-5 py-2 rounded-xl font-semibold transition"
            >
              GitHub
            </a>

            <a
              href={project.demo}
              class="border border-zinc-700 hover:border-cyan-400 px-5 py-2 rounded-xl transition"
            >
              Demo
            </a>

          </div>

        </div>

      </div>

    ))
  }

</div>