---
import { projects } from "../data/Projects.js";
---

<section
  id="projects"
  class="px-6 py-24"
>
  <div class="max-w-6xl mx-auto">

    <p class="text-cyan-400 uppercase tracking-[0.3em] mb-4 text-center">
      Proyectos
    </p>

    <h2 class="text-4xl md:text-5xl font-bold text-center mb-6">
      Experiencia y Desarrollo
    </h2>

    <p class="text-zinc-400 text-lg text-center max-w-3xl mx-auto mb-12">
      Algunos proyectos académicos y personales que reflejan mi interés por
      el desarrollo de software, telecomunicaciones, redes e Internet de las Cosas.
    </p>

    <div class="grid md:grid-cols-2 gap-8">

      {
        projects.map((project) => (

          <div
            class="bg-zinc-900 border border-zinc-800 rounded-3xl overflow-hidden hover:border-cyan-400 hover:shadow-cyan-500/20 hover:shadow-xl hover:-translate-y-2 transition-all duration-300"
          >

            <div
              class={`h-52 flex items-center justify-center ${
                project.color === "cyan"
                  ? "bg-gradient-to-br from-cyan-500/20 to-zinc-900"
                  : "bg-gradient-to-br from-purple-500/20 to-zinc-900"
              }`}
            >

              <span
                class={`text-2xl font-bold ${
                  project.color === "cyan"
                    ? "text-cyan-400"
                    : "text-purple-400"
                }`}
              >
                {project.title}
              </span>

            </div>

            <div class="p-8">

              <div class="mb-4">
                <span class="bg-cyan-500/20 text-cyan-300 px-3 py-1 rounded-full text-xs">
                  {project.status}
                </span>
              </div>

              <h3 class="text-2xl font-bold mb-4">
                {project.subtitle}
              </h3>

              <p class="text-zinc-400 mb-6">
                {project.description}
              </p>

              <div class="flex flex-wrap gap-2 mb-6">

                {
                  project.technologies.map((tech) => (

                    <span
                      class="bg-zinc-800/80 border border-zinc-700 text-cyan-300 px-3 py-1 rounded-full text-sm"
                    >
                      {tech}
                    </span>

                  ))
                }

              </div>

              <div class="flex gap-4">

                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-cyan-400 hover:bg-cyan-300 hover:-translate-y-1 transition-all duration-300 text-black px-5 py-2 rounded-xl font-semibold"
                >
                  GitHub
                </a>

                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border border-zinc-700 hover:border-cyan-400 hover:-translate-y-1 transition-all duration-300 px-5 py-2 rounded-xl"
                >
                  Demo
                </a>

              </div>

            </div>

          </div>

        ))
      }

    </div>

  </div>
</section>