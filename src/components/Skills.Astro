---
import { skills } from "../data/skills.js";
---

<div class="grid grid-cols-2 md:grid-cols-4 gap-6">

  {
    skills.map((skill) => (

      <div
        class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 hover:border-cyan-400 hover:-translate-y-1 transition"
      >

        <h3 class="text-cyan-400 text-xl font-bold mb-2">
          {skill.name}
        </h3>

        <p class="text-zinc-400 text-sm">
          {skill.description}
        </p>

      </div>

    ))
  }

</div>