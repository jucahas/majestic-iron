---
import { timeline } from "../data/Timeline.js";
---

<section
  id="timeline"
  class="px-6 py-24"
>
  <div class="max-w-5xl mx-auto">

    <div class="text-center mb-16">

      <p class="text-cyan-400 uppercase tracking-[0.3em] mb-4">
        Trayectoria
      </p>

      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        Mi Camino en Telemática
      </h2>

      <p class="text-zinc-400 max-w-3xl mx-auto">
        Algunos hitos relevantes de mi formación académica y desarrollo profesional.
      </p>

    </div>

    <div class="relative border-l-2 border-cyan-400 ml-4">

      {
        timeline.map((item) => (

          <div class="mb-12 ml-8 relative">

            <div
              class="absolute -left-[41px] top-1 w-5 h-5 rounded-full bg-cyan-400 shadow-lg shadow-cyan-400/50"
            ></div>

            <div
              class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 hover:border-cyan-400 hover:shadow-cyan-500/20 hover:shadow-xl hover:-translate-y-2 transition-all duration-300"
            >

              <span class="bg-cyan-500/20 text-cyan-300 px-3 py-1 rounded-full text-sm font-semibold">
                {item.year}
              </span>

              <h3 class="text-2xl font-bold mt-2 mb-3">
                {item.title}
              </h3>

              <div class="w-12 h-1 bg-cyan-400 rounded-full mb-4"></div>

              <p class="text-zinc-400">
                {item.description}
              </p>

            </div>

          </div>

        ))
      }

    </div>

  </div>
</section>