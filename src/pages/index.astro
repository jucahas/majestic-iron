---
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Skills from "../components/Skills.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Experience from "../components/Experience.astro";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Juan Gutiérrez | Portafolio</title>

    <meta
      name="description"
      content="Portafolio personal de Juan Gutiérrez, estudiante de Ingeniería Civil Telemática. Desarrollo de software, telecomunicaciones, redes, IoT y tecnologías web."
    />

    <meta
      name="keywords"
      content="Juan Gutiérrez, Portafolio, Ingeniería Civil Telemática, Astro, TailwindCSS, Networking, IoT, Software"
    />

    <meta
      name="author"
      content="Juan Gutiérrez"
    />
  </head>

  <body class="bg-gradient-to-b from-black via-zinc-950 to-black text-white">

    <Navbar />

    <main>
      <Hero />
      <About />
      <Skills />
      <Experience />
      <Projects />
      <Contact />
    </main>

    <Footer />

  </body>
</html>