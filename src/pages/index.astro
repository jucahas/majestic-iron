---
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Juan Gutiérrez | Portafolio</title>
  </head>

  <body class="bg-zinc-950 text-white">

    <main class="min-h-screen flex flex-col items-center justify-center px-6">

      <h1 class="text-5xl md:text-7xl font-bold text-cyan-400 mb-6">
        Juan Gutiérrez
      </h1>

      <p class="text-zinc-300 text-lg md:text-2xl text-center max-w-2xl">
        Estudiante de Ingeniería Civil Telemática apasionado por
        redes, desarrollo de software, IoT y tecnologías web.
      </p>

      <div class="mt-10 flex gap-4">
        <a
          href="#"
          class="bg-cyan-500 hover:bg-cyan-400 transition px-6 py-3 rounded-xl font-semibold text-black"
        >
          Ver proyectos
        </a>

        <a
          href="#"
          class="border border-zinc-600 hover:border-cyan-400 transition px-6 py-3 rounded-xl"
        >
          Contacto
        </a>
      </div>

    </main>

  </body>
</html>